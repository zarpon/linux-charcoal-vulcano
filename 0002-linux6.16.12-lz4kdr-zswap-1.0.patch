diff --git a/crypto/lz4kdr.c b/crypto/lz4kdr.c
new file mode 100644
index 0000000000000000000000000000000000000000..48735efc986f52b41d9398783f554e03a84d5038
--- /dev/null
+++ b/crypto/lz4kdr.c
@@ -0,0 +1,151 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Cryptographic API adapter for LZ4KDR.
+ *
+ * LZ4KDR is a fixed-block compressor.  zswap presents one page per request,
+ * so this adapter keeps the crypto/acomp contract page-oriented while
+ * retaining the algorithm's one-time hash-table initialization requirement.
+ */
+
+#include <crypto/internal/acompress.h>
+#include <linux/init.h>
+#include <linux/kernel.h>
+#include <linux/lz4kdr.h>
+#include <linux/module.h>
+#include <linux/scatterlist.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+/* LZ4KDR currently accepts input blocks up to 4 KiB. */
+#define LZ4KDR_ACOMP_MAX_INPUT	4096U
+#define LZ4KDR_ACOMP_MAX_OUTPUT	8192U
+
+struct lz4kdr_acomp_ctx {
+	/* lz4kdr_encode() mutates this table and requires it to stay warm. */
+	void *state;
+	spinlock_t state_lock;
+};
+
+struct lz4kdr_acomp_req_ctx {
+	u8 input[LZ4KDR_ACOMP_MAX_INPUT];
+	u8 output[LZ4KDR_ACOMP_MAX_OUTPUT];
+};
+
+static int lz4kdr_acomp_init(struct crypto_acomp *tfm)
+{
+	struct lz4kdr_acomp_ctx *ctx = acomp_tfm_ctx(tfm);
+
+	ctx->state = kzalloc(lz4kdr_encode_state_bytes_min(), GFP_KERNEL);
+	if (!ctx->state)
+		return -ENOMEM;
+
+	spin_lock_init(&ctx->state_lock);
+	return 0;
+}
+
+static void lz4kdr_acomp_exit(struct crypto_acomp *tfm)
+{
+	struct lz4kdr_acomp_ctx *ctx = acomp_tfm_ctx(tfm);
+
+	kfree(ctx->state);
+	ctx->state = NULL;
+}
+
+static int lz4kdr_acomp_compress(struct acomp_req *req)
+{
+	struct crypto_acomp *tfm = crypto_acomp_reqtfm(req);
+	struct lz4kdr_acomp_ctx *ctx = acomp_tfm_ctx(tfm);
+	struct lz4kdr_acomp_req_ctx *rctx = acomp_request_ctx(req);
+	unsigned int out_max;
+	unsigned int out_limit;
+	int ret;
+
+	if (!req->slen || req->slen > sizeof(rctx->input))
+		return -E2BIG;
+
+	out_max = min_t(unsigned int, req->dlen, sizeof(rctx->output));
+	if (!out_max)
+		return -ENOSPC;
+
+	if (sg_copy_to_buffer(req->src, sg_nents(req->src), rctx->input,
+			      req->slen) != req->slen)
+		return -EINVAL;
+
+	/* zswap rejects expansion, so ask LZ4KDR for a strictly smaller block. */
+	out_limit = min(req->slen, out_max);
+	spin_lock_bh(&ctx->state_lock);
+	ret = lz4kdr_encode(ctx->state, rctx->input, rctx->output,
+			    req->slen, out_max, out_limit);
+	spin_unlock_bh(&ctx->state_lock);
+
+	if (ret == LZ4KDR_STATUS_INCOMPRESSIBLE)
+		return -ENOSPC;
+	if (ret < 0)
+		return -EINVAL;
+
+	if (sg_copy_from_buffer(req->dst, sg_nents(req->dst), rctx->output,
+				ret) != ret)
+		return -ENOSPC;
+
+	req->dlen = ret;
+	return 0;
+}
+
+static int lz4kdr_acomp_decompress(struct acomp_req *req)
+{
+	struct lz4kdr_acomp_req_ctx *rctx = acomp_request_ctx(req);
+	unsigned int out_max;
+	int ret;
+
+	if (!req->slen || req->slen > sizeof(rctx->input))
+		return -E2BIG;
+
+	out_max = min_t(unsigned int, req->dlen, sizeof(rctx->output));
+	if (!out_max)
+		return -ENOSPC;
+
+	if (sg_copy_to_buffer(req->src, sg_nents(req->src), rctx->input,
+			      req->slen) != req->slen)
+		return -EINVAL;
+
+	ret = lz4kdr_decode(rctx->input, rctx->output, req->slen, out_max);
+	if (ret < 0)
+		return -EINVAL;
+
+	if (sg_copy_from_buffer(req->dst, sg_nents(req->dst), rctx->output,
+				ret) != ret)
+		return -ENOSPC;
+
+	req->dlen = ret;
+	return 0;
+}
+
+static struct acomp_alg acomp = {
+	.compress		= lz4kdr_acomp_compress,
+	.decompress		= lz4kdr_acomp_decompress,
+	.init			= lz4kdr_acomp_init,
+	.exit			= lz4kdr_acomp_exit,
+	.base.cra_name		= "lz4kdr",
+	.base.cra_driver_name	= "lz4kdr-generic",
+	.base.cra_ctxsize	= sizeof(struct lz4kdr_acomp_ctx),
+	.base.cra_reqsize	= sizeof(struct lz4kdr_acomp_req_ctx),
+	.base.cra_module	= THIS_MODULE,
+};
+
+static int __init lz4kdr_acomp_mod_init(void)
+{
+	return crypto_register_acomp(&acomp);
+}
+
+static void __exit lz4kdr_acomp_mod_exit(void)
+{
+	crypto_unregister_acomp(&acomp);
+}
+
+module_init(lz4kdr_acomp_mod_init);
+module_exit(lz4kdr_acomp_mod_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("LZ4KDR asynchronous compression algorithm");
+MODULE_ALIAS_CRYPTO("lz4kdr");
+MODULE_ALIAS_CRYPTO("lz4kdr-generic");
